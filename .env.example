# ---- Database (Postgres) ----
# Production (Supabase/Neon/etc). Get this from your DB provider.
# IMPORTANT: never commit the real value — set it in Vercel's env settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---- Claude / Anthropic ----
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for definitions and voice parsing. Opus 4.8 with high reasoning.
ANTHROPIC_MODEL="claude-opus-4-8"

# Extended-thinking budget (tokens). Higher = more careful reasoning ("high").
# Set to 0 to disable thinking for faster/cheaper responses.
ANTHROPIC_THINKING_TOKENS="6000"
