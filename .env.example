# ---- Database ----
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (Postgres on Vercel/Supabase/Neon) — see DEPLOY.md:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- Claude / Anthropic ----
# Get a key at https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for generating definitions and parsing voice dictation.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- App auth (single-user) ----
# Set a passcode to protect your deck on the public web. Leave blank for no login (local only).
APP_PASSCODE=""
