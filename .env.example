# ---- Database (Postgres) ----
# Production (Supabase/Neon/etc). Get this from your DB provider.
# IMPORTANT: never commit the real value — set it in Vercel's env settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---- Claude / Anthropic ----
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for definitions and voice parsing. Opus 4.8 with adaptive thinking.
ANTHROPIC_MODEL="claude-opus-4-8"

# Reasoning effort: low | medium | high | xhigh | max. Higher = more careful
# (and slower/pricier). Opus 4.8 uses adaptive thinking, so the model decides
# how much to think; effort steers the overall depth. Default is "high".
ANTHROPIC_EFFORT="high"

# Set ANTHROPIC_THINKING="off" to disable thinking entirely (fastest/cheapest).
# ANTHROPIC_THINKING="off"
