# ---- Claude / Anthropic (optional) ----
# Only needed for the two AI features: "Ask Claude for the answer" and turning
# a voice/text brain-dump into cards. The rest of the app works without it.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Optional model + reasoning tuning (sensible defaults if omitted):
# ANTHROPIC_MODEL="claude-opus-4-8"
# ANTHROPIC_EFFORT="high"          # low | medium | high | xhigh | max
# ANTHROPIC_THINKING="off"         # disable thinking for fastest/cheapest

# NOTE: There is no database. Cards are stored in your browser (localStorage).
