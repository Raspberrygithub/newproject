// Prisma schema for the Memory Management (spaced repetition) app.
//
// Local dev uses SQLite (zero setup). For production on Vercel, switch the
// provider to "postgresql" and point DATABASE_URL at a hosted Postgres.
// See DEPLOY.md for the exact steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deck {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  cards     Card[]
}

model Card {
  id        String   @id @default(cuid())
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId    String

  front     String
  back      String
  // Optional comma-separated tags, e.g. "biology,exam"
  tags      String   @default("")

  // ---- Scheduling state (SM-2 inspired, minute-based) ----
  // state: "new" | "learning" | "review"
  state         String   @default("new")
  // intervalMin: current interval in minutes
  intervalMin   Int      @default(0)
  // ease factor (SM-2), default 2.5; floored at 1.3
  ease          Float    @default(2.5)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  due           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]

  @@index([deckId])
  @@index([due])
}

// A log of every answer, for stats and history.
model Review {
  id        String   @id @default(cuid())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  grade     String   // "again" | "hard" | "good" | "easy" | "custom"
  intervalMin Int    // interval applied as a result of this review
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([createdAt])
}
